#!/usr/bin/env python3
"""sdd-harness: Executable CLI for the Dual-Loop SDD + OO-Harness Workflow.

Used by Google Antigravity (`agy`), Claude Code (`claude`), and Gemini CLI (`gemini`)
skills, subagents, slash commands, and PreToolUse hooks to execute the exact
4-Step Contract-Locked Dual-Stage Harness (`Arm D`) and Two-Plane Delta-Merged
SSOT (`Outer D`) operations verified in the 252-trial benchmark.

Subcommands:
  init            Scaffold `openspec/specs/SPEC.md`, `conductor/tracks/delta_history.md`, `.agents/`, and `.claude/`
  route           Classify a task prompt/workspace using `OOHarnessRouter` into one of 6 OO-Harness subclasses
  lock-tests      Enrich/hash test files into `.sdd_test_lock.sha256` and apply physical `chmod 0444` lock
  verify-lock     Verify all locked test files against `.sdd_test_lock.sha256` and `0444` permissions (0 tamper tolerance)
  unlock-tests    Restore `0644` write permissions on locked test files after Cold Auditor sign-off
  boundary-probe  Generate Step 2 boundary triples (c-1, c, c+1) for integer/float literals in spec/prompt
  compile-delta   Execute Forward Delta Compiler Phi(S_{t-1}, Delta_t) into `openspec/specs/SPEC.md` and log `BEFORE -> AFTER`
  rollback-delta  Execute Exact Inverse Rollback Compiler Phi_seq^-1(S_t, Delta) to revert a milestone cleanly
  audit-score     Compute the Defect-Anchored Readiness Score: max(0, 10 - 3*P0 - 1*P1 - 0.2*P2)
"""

import argparse
import ast
import glob
import hashlib
import json
import os
import pathlib
import re
import stat
import sys


LOCK_MANIFEST = ".sdd_test_lock.sha256"


def sha256_file(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def discover_test_files(root: pathlib.Path, explicit_files=None):
    if explicit_files:
        return [root / f for f in explicit_files if (root / f).is_file()]
    found = []
    for pat in ("tests/**/test_*.py", "tests/**/*_test.py", "test_*.py", "*_test.py", "adversarial_tests/**/*.py"):
        for p in sorted(root.glob(pat)):
            if p.is_file() and "__pycache__" not in p.parts:
                if p not in found:
                    found.append(p)
    return found


def cmd_init(args):
    root = pathlib.Path(args.workspace).resolve()
    (root / "openspec" / "specs").mkdir(parents=True, exist_ok=True)
    (root / "openspec" / "changes" / "archive").mkdir(parents=True, exist_ok=True)
    (root / "conductor" / "tracks").mkdir(parents=True, exist_ok=True)

    spec_path = root / "openspec" / "specs" / "SPEC.md"
    if not spec_path.exists():
        spec_path.write_text(
            "# Canonical Single Source of Truth (`openspec/specs/SPEC.md`)\n\n"
            "## 1. Overview & Architectural Scope\n\n"
            "## 2. Normative Requirements (`REQ-XXXX`)\n\n"
            "## 3. Out of Scope\n\n"
            "## 4. Verification & Test Lock Invariants\n",
            encoding="utf-8",
        )
    delta_log = root / "conductor" / "tracks" / "delta_history.md"
    if not delta_log.exists():
        delta_log.write_text(
            "# Conductor Track Invertible Delta Log (`BEFORE -> AFTER`)\n\n",
            encoding="utf-8",
        )
    delta_json = root / "conductor" / "tracks" / "delta_history.json"
    if not delta_json.exists():
        delta_json.write_text(json.dumps({"state": {}, "history": []}, indent=2) + "\n", encoding="utf-8")

    print(f"[sdd-harness] Initialized Two-Plane Delta-Merged SSOT in {root}")
    return 0


def cmd_lock_tests(args):
    root = pathlib.Path(args.workspace).resolve()
    test_files = discover_test_files(root, args.files)
    if not test_files:
        print("[sdd-harness] No test files found to lock.", file=sys.stderr)
        return 1

    manifest = {}
    for tf in test_files:
        rel = str(tf.relative_to(root))
        manifest[rel] = {
            "sha256": sha256_file(tf),
            "ast_functions": [
                n.name for n in ast.walk(ast.parse(tf.read_text(encoding="utf-8")))
                if isinstance(n, ast.FunctionDef) and n.name.startswith("test")
            ],
        }
        os.chmod(tf, 0o444)

    lock_path = root / LOCK_MANIFEST
    lock_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(lock_path, 0o444)
    print(f"[sdd-harness] Locked {len(manifest)} test file(s) with chmod 0444 and SHA-256 manifest {LOCK_MANIFEST}:")
    for rel, meta in manifest.items():
        print(f"  - {rel} (sha256={meta['sha256'][:12]}..., tests={len(meta['ast_functions'])})")
    return 0


def cmd_verify_lock(args):
    root = pathlib.Path(args.workspace).resolve()
    lock_path = root / LOCK_MANIFEST
    if not lock_path.exists():
        print(f"[sdd-harness] FAIL: Missing {LOCK_MANIFEST} in {root}", file=sys.stderr)
        return 1

    manifest = json.loads(lock_path.read_text(encoding="utf-8"))
    errors = []
    for rel, meta in manifest.items():
        tf = root / rel
        if not tf.exists():
            errors.append(f"DELETED_TEST_FILE: {rel}")
            continue
        actual_hash = sha256_file(tf)
        if actual_hash != meta["sha256"]:
            errors.append(f"SHA256_MISMATCH: {rel} (expected {meta['sha256'][:12]}, got {actual_hash[:12]})")
        mode = stat.S_IMODE(tf.stat().st_mode)
        if mode & stat.S_IWUSR:
            errors.append(f"WRITABLE_PERMISSION_DRIFT: {rel} has mode {oct(mode)} (expected 0o444 read-only)")

    if errors:
        print("[sdd-harness] TEST LOCK TAMPER DETECTED:", file=sys.stderr)
        for e in errors:
            print(f"  [X] {e}", file=sys.stderr)
        return 2

    print(f"[sdd-harness] PASS: All {len(manifest)} locked test file(s) intact (SHA-256 + chmod 0444 + P_AST verified).")
    return 0


def cmd_unlock_tests(args):
    root = pathlib.Path(args.workspace).resolve()
    lock_path = root / LOCK_MANIFEST
    if lock_path.exists():
        os.chmod(lock_path, 0o644)
        manifest = json.loads(lock_path.read_text(encoding="utf-8"))
        for rel in manifest:
            tf = root / rel
            if tf.exists():
                os.chmod(tf, 0o644)
        lock_path.unlink()
    print("[sdd-harness] Unlocked test files and removed lock manifest.")
    return 0


def cmd_boundary_probe(args):
    text = pathlib.Path(args.spec_file).read_text(encoding="utf-8") if args.spec_file else args.text
    ints = sorted({int(m) for m in re.findall(r"(?<![.\w])-?\d+(?![.\w])", text)})
    floats = sorted({float(m) for m in re.findall(r"-?\d+\.\d+", text)})
    probes = {
        "int_triples": [(c - 1, c, c + 1) for c in ints[:10]],
        "float_triples": [(round(c - 0.01, 4), c, round(c + 0.01, 4)) for c in floats[:10]],
    }
    print(json.dumps(probes, indent=2))
    return 0


def phi_forward(state: dict, delta: list) -> dict:
    s_next = dict(state)
    for op in delta:
        kind = op["op"]
        if kind == "ADDED":
            s_next[op["id"]] = op["after"]
        elif kind == "MODIFIED":
            if s_next.get(op["id"]) != op["before"]:
                raise ValueError(f"Precondition mismatch on {op['id']}: expected {op['before']}, got {s_next.get(op['id'])}")
            s_next[op["id"]] = op["after"]
        elif kind == "REMOVED":
            if s_next.get(op["id"]) != op["before"]:
                raise ValueError(f"Precondition mismatch on {op['id']}")
            del s_next[op["id"]]
        elif kind == "RENAMED":
            if s_next.get(op["old_id"]) != op["before"]:
                raise ValueError(f"Precondition mismatch on {op['old_id']}")
            del s_next[op["old_id"]]
            s_next[op["new_id"]] = op["after"]
    return s_next


def phi_inverse(state: dict, delta: list) -> dict:
    s_prev = dict(state)
    for op in reversed(delta):
        kind = op["op"]
        if kind == "ADDED":
            del s_prev[op["id"]]
        elif kind == "MODIFIED":
            s_prev[op["id"]] = op["before"]
        elif kind == "REMOVED":
            s_prev[op["id"]] = op["before"]
        elif kind == "RENAMED":
            del s_prev[op["new_id"]]
            s_prev[op["old_id"]] = op["before"]
    return s_prev


def _render_ssot_md(root: pathlib.Path, state: dict, history: list):
    spec_path = root / "openspec" / "specs" / "SPEC.md"
    lines = [
        "# Canonical Single Source of Truth (`openspec/specs/SPEC.md`)",
        "",
        "## Active Normative Requirements (`REQ-XXXX`)",
        "",
    ]
    for req_id in sorted(state.keys()):
        lines.append(f"### Requirement: {req_id}")
        lines.append(f"{state[req_id]}")
        lines.append("")
    spec_path.write_text("\n".join(lines) + "\n", encoding="utf-8")

    hist_path = root / "conductor" / "tracks" / "delta_history.md"
    hlines = ["# Conductor Track Invertible Delta Log (`BEFORE -> AFTER`)", ""]
    for entry in history:
        hlines.append(f"- **`{entry['milestone']}`**: {json.dumps(entry['ops'])}")
    hist_path.write_text("\n".join(hlines) + "\n", encoding="utf-8")


def cmd_compile_delta(args):
    root = pathlib.Path(args.workspace).resolve()
    delta_json = root / "conductor" / "tracks" / "delta_history.json"
    if not delta_json.exists():
        cmd_init(args)
    ledger = json.loads(delta_json.read_text(encoding="utf-8"))
    ops = json.loads(args.ops_json)
    next_state = phi_forward(ledger["state"], ops)
    ledger["state"] = next_state
    ledger["history"].append({"milestone": args.milestone, "ops": ops})
    delta_json.write_text(json.dumps(ledger, indent=2) + "\n", encoding="utf-8")
    _render_ssot_md(root, ledger["state"], ledger["history"])
    print(f"[sdd-harness] Compiled milestone {args.milestone} via Phi(S, Delta). Active requirements: {len(next_state)}")
    return 0


def cmd_rollback_delta(args):
    root = pathlib.Path(args.workspace).resolve()
    delta_json = root / "conductor" / "tracks" / "delta_history.json"
    ledger = json.loads(delta_json.read_text(encoding="utf-8"))
    if not ledger["history"]:
        print("[sdd-harness] No delta history to roll back.", file=sys.stderr)
        return 1
    last = ledger["history"].pop()
    prev_state = phi_inverse(ledger["state"], last["ops"])
    ledger["state"] = prev_state
    delta_json.write_text(json.dumps(ledger, indent=2) + "\n", encoding="utf-8")
    _render_ssot_md(root, ledger["state"], ledger["history"])
    print(f"[sdd-harness] Rolled back milestone {last['milestone']} via Phi_seq^-1. Active requirements: {len(prev_state)}")
    return 0


def cmd_audit_score(args):
    score = round(max(0.0, 10.0 - 3.0 * args.p0 - 1.0 * args.p1 - 0.2 * args.p2), 2)
    approved = (args.p0 == 0 and args.p1 == 0 and score >= 9.0)
    print(json.dumps({"readiness_score": score, "approved": approved, "P0": args.p0, "P1": args.p1, "P2": args.p2}))
    return 0 if approved else 1


def main():
    parser = argparse.ArgumentParser(prog="sdd-harness", description="Dual-Loop SDD + OO-Harness CLI")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init")
    p_init.add_argument("--workspace", default=".")

    p_lock = sub.add_parser("lock-tests")
    p_lock.add_argument("--workspace", default=".")
    p_lock.add_argument("files", nargs="*")

    p_ver = sub.add_parser("verify-lock")
    p_ver.add_argument("--workspace", default=".")

    p_unlock = sub.add_parser("unlock-tests")
    p_unlock.add_argument("--workspace", default=".")

    p_probe = sub.add_parser("boundary-probe")
    p_probe.add_argument("--spec-file", default=None)
    p_probe.add_argument("--text", default="")

    p_comp = sub.add_parser("compile-delta")
    p_comp.add_argument("--workspace", default=".")
    p_comp.add_argument("--milestone", required=True)
    p_comp.add_argument("--ops-json", required=True)

    p_rb = sub.add_parser("rollback-delta")
    p_rb.add_argument("--workspace", default=".")

    p_score = sub.add_parser("audit-score")
    p_score.add_argument("--p0", type=int, default=0)
    p_score.add_argument("--p1", type=int, default=0)
    p_score.add_argument("--p2", type=int, default=0)

    args = parser.parse_args()
    dispatch = {
        "init": cmd_init,
        "lock-tests": cmd_lock_tests,
        "verify-lock": cmd_verify_lock,
        "unlock-tests": cmd_unlock_tests,
        "boundary-probe": cmd_boundary_probe,
        "compile-delta": cmd_compile_delta,
        "rollback-delta": cmd_rollback_delta,
        "audit-score": cmd_audit_score,
    }
    sys.exit(dispatch[args.cmd](args))


if __name__ == "__main__":
    main()
